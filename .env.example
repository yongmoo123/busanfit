# 부산핏 환경변수 이름 목록. 값은 각자 .env 또는 셸에만 넣고 커밋하지 않는다.
# 서버(app.main:app)는 .env를 자동으로 읽지 않는다. 셸에서 설정하거나 uvicorn --env-file .env 로 넘긴다.
# 설명: docs/SUBMISSION_RUN.md §3, backend/app/data/README.md

# SQLite DB 파일 경로 (필수, 기본값 없음). 제출본: data/share/busanfit_v3.sqlite3 의 절대 경로
BUSANFIT_DB_PATH=

# 도보 검색 반경(미터, 선택). 비우면 1500 (DEC-001). 숫자가 아니거나 0 이하면 오류
BUSANFIT_WALK_RADIUS_M=

# Gemini (선택, backend/app/ai/gemini.py). 둘 다 있어야 사용. 없으면 규칙 파서로 동작하고 AI_FALLBACK 경고
GEMINI_API_KEY=
GEMINI_MODEL=

# 프론트 Vite /api 프록시 대상 (선택, frontend/vite.config.js). 비우면 http://127.0.0.1:8000
BUSANFIT_API_TARGET=
# 예전 이름. BUSANFIT_API_TARGET이 없을 때만 사용
BUSANFIT_API_PROXY_TARGET=

# 카카오 지도 JavaScript 키 (선택, frontend/src/CourseMap.jsx). Vite 시작 전에 설정. 없으면 지도만 미표시
VITE_KAKAO_JS_KEY=

# TourAPI 서비스키 (pipelines 수집 전용, 공유 DB를 쓰면 불필요). 하나면 두 서비스에 같이 쓰고, 서비스별 이름이 있으면 그것을 우선
TOURAPI_SERVICE_KEY=
TOURAPI_KOR_SERVICE_KEY=
TOURAPI_WITH_SERVICE_KEY=

# 기상청 서비스키 (단기예보·기상특보, FR-016). 날씨 모듈 준비됨, 코스 연결은 향후 과제(DEC-036).
# 없으면 날씨는 호출 없이 NOT_APPLIED(NO_KEY)
KMA_SERVICE_KEY=
