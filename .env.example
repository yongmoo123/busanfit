# 부산핏 환경변수 이름 목록. 값은 각자 .env 또는 셸에만 넣고 커밋하지 않는다.
# 설명: backend/app/data/README.md

# SQLite DB 파일 경로 (필수, 기본값 없음)
BUSANFIT_DB_PATH=

# TourAPI 서비스키 (pipelines, 값은 .env에만). 하나면 두 서비스에 같이 쓰고, 서비스별 이름이 있으면 그것을 우선
TOURAPI_SERVICE_KEY=
TOURAPI_KOR_SERVICE_KEY=
TOURAPI_WITH_SERVICE_KEY=

# 도보 검색 반경(미터, 선택). 비우면 1500 (DEC-001). 숫자가 아니거나 0 이하면 오류
BUSANFIT_WALK_RADIUS_M=
