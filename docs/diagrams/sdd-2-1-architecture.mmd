  classDef sdk fill:#FFF4DC,stroke:#1F3A5C,stroke-width:1.5px,color:#1F3A5C
  classDef data fill:#E5EDE4,stroke:#1F3A5C,stroke-width:1.5px,color:#1F3A5C
